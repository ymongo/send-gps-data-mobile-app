<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 splash background.
     Layer-list: full-screen vertical purple gradient + centered pink logo.
     The logo is a VectorDrawable (density-independent), so no per-density
     PNG is needed. Sized ~150dp, centered, never stretched. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- gradient background covering the whole screen -->
    <item android:drawable="@drawable/splash_bg_gradient" />

    <!-- centered logo only (no text): VectorDrawable, density-independent -->
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_splash_logo" />
    </item>

</layer-list>
