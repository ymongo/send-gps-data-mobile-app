{
  "name": "gps-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5174",
    "prod": "vite build",
    "test:e2e": "playwright test",
    "build:prod": "NODE_OPTIONS=\"--max-old-space-size=4096\" vite build && playwright test",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest run",
    "build:apk": "bash scripts/build-apk.sh",
    "sync": "cap sync",
    "check:devices": "adb devices -l",
    "deploy": "npm run build && npm run sync && npx cap run android",
    "deploy:prod": "npm run build:apk && npx cap copy android && adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "logs": "adb logcat | grep -iE \"sendgpsdata|capacitor|chromium|console|webview|websocket|wss|error|exception|crash\""
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.47.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22",
    "daisyui": "^5.5.5",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.12.4",
    "fast-check": "^3.23.2",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "svelte": "^5.41.0",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.14",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "vitest": "^4.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^7.5.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/barcode-scanner": "^2.2.6",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/device": "^7.0.2",
    "@capacitor/geolocation": "^7.0.0",
    "gps-shared": "*",
    "qrcode": "^1.5.4"
  }
}
